# OpenAI API配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4

# Neo4j配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=starmap123

# Redis配置
REDIS_URL=redis://localhost:6379

# ChromaDB配置
CHROMA_HOST=localhost
CHROMA_PORT=8001

# 后端配置
ENV=development
LOG_LEVEL=INFO
ADMIN_JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_JWT_EXPIRE_MINUTES=480
AUTH_ACTION_TOKEN_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
AUTH_CSRF_SECRET=replace-with-a-different-random-secret-at-least-32-characters
AUTH_IDENTIFIER_HMAC_SECRET=replace-with-another-random-secret-at-least-32-characters
AUTH_FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# GitHub OAuth App 本地回调
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
AUTH_GITHUB_TRANSACTION_MINUTES=10

# 本地不发真实邮件时保留 memory；真实联调改成 smtp 并填写下方配置
AUTH_EMAIL_BACKEND=memory
AUTH_EMAIL_FROM_ADDRESS=
AUTH_EMAIL_FROM_NAME=408 学习工作台
AUTH_EMAIL_REPLY_TO=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SECURITY=starttls
AUTH_SMTP_TIMEOUT_SECONDS=10
CORPUS_UPLOAD_DIR=./backend/uploads
CORPUS_UPLOAD_MAX_BYTES=209715200
